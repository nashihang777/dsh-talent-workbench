{
  "name": "@nashihang777/dsh-talent-workbench",
  "version": "1.6.1",
  "type": "module",
  "description": "本地优先的人才匹配工作台：可调权重的岗位模板（研究型 + 互联网/制造/医疗/金融等岗位族）、独立维度技能、简历批量导入、可回溯的筛选推导与匿名交换账本。",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "recruiting",
    "resume-screening",
    "talent-matching",
    "local-first"
  ],
  "homepage": "https://github.com/nashihang777/dsh-talent-workbench#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nashihang777/dsh-talent-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/nashihang777/dsh-talent-workbench/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "skills",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
